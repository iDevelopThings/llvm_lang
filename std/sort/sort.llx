// sort.llx - std/sort: in-place heapsort over dynamic arrays.

import "std:log"

func siftDown[T](s []T, start int, end int, less func(T, T) bool) {
    root := start
    for {
        child := 2 * root + 1
        if child >= end {
            return
        }
        if child + 1 < end {
            if less(s[child], s[child+1]) {
                child = child + 1
            }
        }
        if !less(s[root], s[child]) {
            return
        }
        tmp := s[root]
        s[root] = s[child]
        s[child] = tmp
        root = child
    }
}

func Sort[T](s []T, less func(T, T) bool) {
    n := len(s)
    if n < 2 {
        return
    }
    start := n / 2 - 1
    for start >= 0 {
        siftDown(s, start, n, less)
        start = start - 1
    }
    end := n - 1
    for end > 0 {
        tmp := s[end]
        s[end] = s[0]
        s[0] = tmp
        siftDown(s, 0, end, less)
        end = end - 1
    }
}

func SortNumeric[T](s []T) {
    Sort(s, func(a T, b T) bool {
        return a < b
    })
}

tests {
    import "std:test"

    func TestSortEmpty(t *test.Runner) {
        s := make([]int, 0)
        SortNumeric(s)
        t.AssertEqual(len(s), 0, "empty")
    }

    func TestSortInts(t *test.Runner) {
        ii := make([]int, 0)
        ii = append(ii, 7)
        SortNumeric(ii)
        // Mainly to ensure generic compat
    }
    func TestSortInt64s(t *test.Runner) {
        ii := make([]i64, 0)
        ii = append(ii, 7)
        SortNumeric(ii)
        // Mainly to ensure generic compat
    }

    func TestSortSingleton(t *test.Runner) {
        s := make([]int, 0)
        s = append(s, 7)
        SortNumeric(s)
        t.AssertEqual(s[0], 7, "one")
    }

    func TestSortUnsorted(t *test.Runner) {
        s := make([]int, 0)
        s = append(s, 3)
        s = append(s, 1)
        s = append(s, 4)
        s = append(s, 1)
        s = append(s, 5)
        SortNumeric(s)
        t.AssertEqual(s[0], 1, "0")
        t.AssertEqual(s[1], 1, "1")
        t.AssertEqual(s[2], 3, "2")
        t.AssertEqual(s[3], 4, "3")
        t.AssertEqual(s[4], 5, "4")
    }

    func TestSortAlreadySorted(t *test.Runner) {
        s := make([]int, 0)
        s = append(s, 1)
        s = append(s, 2)
        s = append(s, 3)
        SortNumeric(s)
        t.AssertEqual(s[0], 1, "sorted0")
        t.AssertEqual(s[2], 3, "sorted2")
    }
}