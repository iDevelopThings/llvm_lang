// maps.llx - std/maps: small helpers over built-in map values.
// Keys/Values each allocate one result slice.

func Has[K, V](m map[K]V, k K) bool {
    _, ok := m[k]
    return ok
}

func Keys[K, V](m map[K]V) []K {
    out := make([]K, 0)
    for k := range m {
        out = append(out, k)
    }
    return out
}

func Values[K, V](m map[K]V) []V {
    out := make([]V, 0)
    for _, v := range m {
        out = append(out, v)
    }
    return out
}

tests {
    import "std:test"

    func TestHas(t *test.Runner) {
        m := make(map[string]int)
        m["a"] = 1
        t.Assert(Has(m, "a"), "has a")
        t.Assert(!Has(m, "b"), "missing b")
    }

    func TestKeysValues(t *test.Runner) {
        m := make(map[string]int)
        m["x"] = 10
        m["y"] = 20
        ks := Keys(m)
        t.AssertEqual(len(ks), 2, "key count")
        vs := Values(m)
        t.AssertEqual(len(vs), 2, "value count")
        t.Assert(Has(m, ks[0]), "key0 in map")
        t.Assert(Has(m, ks[1]), "key1 in map")
        sum := 0
        i := 0
        for i < len(vs) {
            sum = sum + vs[i]
            i++
        }
        t.AssertEqual(sum, 30, "value sum")
    }
}