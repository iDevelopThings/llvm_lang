// maps.llx - std/maps: helpers over built-in map values.
// IterKeys/IterValues are zero-alloc generators; Keys/Values collect into a
// fresh slice when a materialised result is needed.

func Has[K, V](m map[K]V, k K) bool {
    _, ok := m[k]
    return ok
}

func IterKeys[K, V](m map[K]V) yield K {
    for k := range m {
        yield k
    }
}

func IterValues[K, V](m map[K]V) yield V {
    for _, v := range m {
        yield v
    }
}

func Keys[K, V](m map[K]V) []K {
    out := make([]K, 0)
    for k := range m {
        out = append(out, k)
    }
    return out
}

func Values[K, V](m map[K]V) []V {
    out := make([]V, 0)
    for _, v := range m {
        out = append(out, v)
    }
    return out
}

tests {
    import "std:test"

    func TestHas(t *test.Runner) {
        m := make(map[string]int)
        m["a"] = 1
        t.Assert(Has(m, "a"), "has a")
        t.Assert(!Has(m, "b"), "missing b")
    }

    func TestKeysValues(t *test.Runner) {
        m := make(map[string]int)
        m["x"] = 10
        m["y"] = 20
        ks := Keys(m)
        t.AssertEqual(len(ks), 2, "key count")
        vs := Values(m)
        t.AssertEqual(len(vs), 2, "value count")
        t.Assert(Has(m, ks[0]), "key0 in map")
        t.Assert(Has(m, ks[1]), "key1 in map")
        sum := 0
        i := 0
        for i < len(vs) {
            sum = sum + vs[i]
            i++
        }
        t.AssertEqual(sum, 30, "value sum")
    }

    func TestIterKeysValues(t *test.Runner) {
        m := make(map[string]int)
        m["x"] = 10
        m["y"] = 20
        keyCount := 0
        for k := range IterKeys(m) {
            t.Assert(Has(m, k), "iter key")
            keyCount = keyCount + 1
        }
        t.AssertEqual(keyCount, 2, "IterKeys count")

        sum := 0
        for v := range IterValues(m) {
            sum = sum + v
        }
        t.AssertEqual(sum, 30, "IterValues sum")
    }
}