// strings.llx - std/strings: string helpers, built entirely as ordinary
// .llx code (see LANGUAGE.md's "Standard library" section) - deliberately
// with NO extern func anywhere in this file. This project's own `string` is
// a `{ptr, i32}` fat struct (see CODEGEN.md's "string representation"
// section), not a null-terminated C string - it has no representation a
// real C function could receive at all, and extern func's own type
// restriction already rejects `string` outright (see LANGUAGE.md's
// "External functions (FFI)" section). So everything here is hand-written
// using only this language's own existing string primitives: slicing
// (`s[a:b]`), `len`, `==`, `+` concatenation, and ordinary loops - no
// per-byte indexing exists for `string` (only a fixed-size/dynamic *array*
// supports `[i]` - see sema's checkIndexExpr), so a "current character" is
// always a length-1 *slice* (`s[i:i+1]`), compared with `==`/`<`/`<=` (a
// string's own ordering operators are already real byte-by-byte lexicographic
// comparisons - see LANGUAGE.md's "Operators" section), never a byte value.
//
// Every exported name here is capitalized (`Contains`, `IndexOf`, ...),
// not the lowercase spelling Go's own real `strings` package uses for the
// same operation (`strings.Index`, ...) - this project's own Go-style
// name-case visibility rule (LANGUAGE.md's "Imports" section) means an
// unexported name simply isn't reachable through a package qualifier at
// all, and the entire point of this package is to be called from another
// package's code, so every one of these has to be exported.
//
// ASCII-only throughout, deliberately - this language has no Unicode
// awareness anywhere yet (no rune type, no UTF-8-aware iteration), so
// "a character" here always means exactly one byte/one string index unit.

// Contains reports whether substr appears anywhere within s (including as
// the empty string, which is considered to appear in any s - matching Go's
// own strings.Contains("", "") == true / strings.Contains("abc", "") == true).
func Contains(s string, substr string) bool {
    return IndexOf(s, substr) >= 0
}

// IndexOf returns the index of substr's first occurrence in s, or -1 if it
// never occurs - mirroring Go's own strings.Index exactly, edge cases
// included: an empty substr is always found, at index 0, regardless of s
// (even an empty s) - matching Go's own strings.Index(s, "") == 0 for any s.
// A substr longer than s can never occur, so that's rejected up front
// without ever needing the search loop below to run.
func IndexOf(s string, substr string) int {
    if len(substr) == 0 {
        return 0
    }
    if len(substr) > len(s) {
        return -1
    }

    i := 0
    for i <= len(s) - len(substr) {
        if s[i:i+len(substr)] == substr {
            return i
        }
        i++
    }
    return -1
}

// HasPrefix reports whether s begins with prefix - an empty prefix always
// matches (matching Go's own strings.HasPrefix(s, "") == true for any s).
func HasPrefix(s string, prefix string) bool {
    if len(prefix) > len(s) {
        return false
    }
    return s[0:len(prefix)] == prefix
}

// HasSuffix reports whether s ends with suffix - an empty suffix always
// matches, same reasoning as HasPrefix above.
func HasSuffix(s string, suffix string) bool {
    if len(suffix) > len(s) {
        return false
    }
    return s[len(s)-len(suffix):len(s)] == suffix
}

// TrimSpace trims leading/trailing ASCII space characters (` `, 0x20) only -
// deliberately not full Go-style Unicode-whitespace trimming (tab, newline,
// carriage return, ...): this language has no Unicode awareness anywhere
// yet, and going beyond the literal space character would need a small
// hand-rolled "is this whitespace" table anyway, which isn't obviously worth
// it for a first standard-library round. Document this narrowness at the
// call site if a caller actually needs tab/newline trimming too.
func TrimSpace(s string) string {
    start := 0
    end := len(s)

    for start < end && s[start:start+1] == " " {
        start++
    }
    for end > start && s[end-1:end] == " " {
        end--
    }

    return s[start:end]
}

// Split splits s on every occurrence of sep, Go-style - matching Go's own
// real strings.Split behavior exactly, including its two documented edge
// cases:
//   - Split(s, "") splits s into its individual one-byte pieces (there's no
//     rune/UTF-8 concept here, so this is a byte split, not Go's own
//     UTF-8-sequence split) - except Split("", "") specifically, which
//     returns an empty slice (len 0), matching Go's own
//     strings.Split("", "") == []string{} rather than []string{""}.
//   - Split(s, sep) with a non-empty sep that never occurs in s (including
//     s == "") returns a length-1 slice containing s itself unchanged,
//     matching Go's own strings.Split("abc", ",") == []string{"abc"} and
//     strings.Split("", ",") == []string{""}.
func Split(s string, sep string) []string {
    result := make([]string, 0)

    if len(sep) == 0 {
        if len(s) == 0 {
            return result
        }
        i := 0
        for i < len(s) {
            result = append(result, s[i:i+1])
            i++
        }
        return result
    }

    start := 0
    i := 0
    for i <= len(s) - len(sep) {
        if s[i:i+len(sep)] == sep {
            result = append(result, s[start:i])
            i = i + len(sep)
            start = i
        } else {
            i++
        }
    }
    result = append(result, s[start:len(s)])
    return result
}

// lowerAlphabet/upperAlphabet are the two case-mapping tables ToUpper/
// ToLower both share - see the comment on toCaseUsing below for why a table
// lookup (via IndexOf, itself already defined above) reads better here than
// a 26-branch if/else chain: this language has no way to turn a character
// into its underlying byte value at all (no rune/byte conversion, no
// numeric cast from string - see LANGUAGE.md's "Explicit conversions"
// section, scoped to numeric-to-numeric only), so any case mapping has to
// go character-string to character-string directly, and a parallel-table
// lookup is the natural way to do that with only the primitives this
// language actually has.
var lowerAlphabet string = "abcdefghijklmnopqrstuvwxyz"
var upperAlphabet string = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

// toCaseUsing rebuilds s one character at a time: for each character, look
// it up in `from`'s table (IndexOf on a single character against a 26-char
// table is a handful of comparisons at worst, plenty cheap for a hobby
// language's own standard library) and, if found, substitute the same
// index's character out of `to` instead; anything not found (already the
// target case, a digit, punctuation, a space, ...) passes through
// unchanged.
func toCaseUsing(s string, from string, to string) string {
    result := ""
    i := 0
    for i < len(s) {
        c := s[i:i+1]
        idx := IndexOf(from, c)
        if idx >= 0 {
            result = result + to[idx:idx+1]
        } else {
            result = result + c
        }
        i++
    }
    return result
}

// ToUpper upper-cases every ASCII a-z character in s; anything else (already
// uppercase, digits, punctuation, spaces) passes through unchanged.
func ToUpper(s string) string {
    return toCaseUsing(s, lowerAlphabet, upperAlphabet)
}

// ToLower lower-cases every ASCII A-Z character in s; anything else passes
// through unchanged, symmetric with ToUpper above.
func ToLower(s string) string {
    return toCaseUsing(s, upperAlphabet, lowerAlphabet)
}

// digitChars is IntToString's own single-digit lookup table - the same
// "index into a small fixed string" trick toCaseUsing above uses, here to
// turn a 0-9 remainder into its printable character without ever needing a
// byte-value/rune concept this language doesn't have.
var digitChars string = "0123456789"

// Int64ToString converts n to its base-10 decimal string, handling two traps
// a naively-ported "while n > 0" itoa hits:
//   - n == 0 is special-cased up front, returning "0" directly - the
//     reverse-digit-extraction loop below never runs at all for 0.
//   - a negative n is NEVER negated to a positive magnitude first - i64's
//     own minimum has no representable positive i64 to negate into (it
//     would silently overflow back to itself, two's complement's one
//     self-negating value, leaving every digit unextracted). Digits are
//     extracted directly from the negative value instead: `%`/`/` both
//     truncate toward zero (see LANGUAGE.md's "Operators" section), so a
//     negative n%10 is already each digit's own negation (`-42 % 10 == -2`),
//     and n/10 shrinks a negative magnitude toward zero exactly like it
//     shrinks a positive one - the loop condition and multiply-by-sign are
//     the only things that differ between the two branches below.
//
// Digits are built into the result by prepending each new one to whatever's
// already been accumulated (`digitChars[d:d+1] + result`, not
// `result + digitChars[d:d+1]`) - string concatenation is the only
// "buffer" primitive this language's string type actually offers (no
// mutable byte buffer / in-place reverse to do instead), so building the
// correctly-ordered string directly this way, rather than accumulating in
// reverse and reversing afterwards, is the simplest option available.
func Int64ToString(n i64) string {
    if n == 0 {
        return "0"
    }

    negative := n < 0
    value := n
    result := ""
    if negative {
        for value < 0 {
            d := i32(-(value % 10))
            result = digitChars[d:d+1] + result
            value = value / 10
        }
        return "-" + result
    }

    for value > 0 {
        d := i32(value % 10)
        result = digitChars[d:d+1] + result
        value = value / 10
    }
    return result
}

// IntToString is Int64ToString with n widened to i64 first - i32's own
// range is a strict subset of i64's, so this covers every int value.
func IntToString(n int) string {
    return Int64ToString(i64(n))
}

// UInt64ToString converts n to its base-10 decimal string - simpler than
// Int64ToString, since an unsigned value is never negative, so there's no
// sign to record/strip/reapply.
func UInt64ToString(n u64) string {
    if n == 0 {
        return "0"
    }

    value := n
    result := ""
    for value > 0 {
        d := i32(value % 10)
        result = digitChars[d:d+1] + result
        value = value / 10
    }
    return result
}

// F64ToStringPrecision renders x as a fixed-precision decimal string with
// exactly `decimals` digits after the decimal point (`decimals` must be >=
// 1) - a deliberately simple fixed-precision format, not a general
// shortest-round-tripping float formatter (Go's own strconv.FormatFloat
// with a real precision/rounding-mode search is a lot more machinery than
// is worth building for this round - see AGENTS.md's task description for
// this being explicitly a "don't force it" nice-to-have).
//
// The whole and fractional parts are computed directly with plain
// arithmetic - no libc call/no std/mathutil dependency needed at all: since
// the value is made non-negative up front (sign handled separately, same
// pattern IntToString above uses), `i32(v)` (float -> int, truncates toward
// zero per LANGUAGE.md's "Explicit conversions" section) already behaves
// exactly like floor for a non-negative operand, so there's no reason to
// reach for std/mathutil's own Floor for this.
//
// Rounding to `decimals` places is the classic "add half a unit in the last
// place, then truncate" trick (`frac*scale + 0.5`, then i32(...) to
// truncate) - which can occasionally round the fractional part up to
// exactly `scale` (e.g. x very slightly below the next whole number), so
// that's detected and carried into the integer part explicitly afterwards.
func F64ToStringPrecision(x f64, decimals int) string {
    negative := x < 0.0
    v := x
    if negative {
        v = -v
    }

    scale := 1.0
    i := 0
    for i < decimals {
        scale = scale * 10.0
        i = i + 1
    }

    intPart := i32(v)
    frac := v - f64(intPart)
    scaled := i32(frac*scale + 0.5)
    maxScaled := i32(scale)
    if scaled >= maxScaled {
        scaled = scaled - maxScaled
        intPart = intPart + 1
    }

    fracStr := IntToString(scaled)
    for len(fracStr) < decimals {
        fracStr = "0" + fracStr
    }

    result := IntToString(intPart) + "." + fracStr
    if negative {
        result = "-" + result
    }
    return result
}

// F64ToString is F64ToStringPrecision with decimals fixed to 4 (e.g.
// "3.1416", "-1.5000", "0.0000") - this package's original, still most
// common formatting need.
func F64ToString(x f64) string {
    return F64ToStringPrecision(x, 4)
}

enum IntParseResult {
    Ok(int),
    Invalid,
    Overflow,
}

enum I64ParseResult {
    Ok(i64),
    Invalid,
    Overflow,
}

enum U64ParseResult {
    Ok(u64),
    Invalid,
    Overflow,
}

enum F64ParseResult {
    Ok(f64),
    Invalid,
}

func digitValue(c string) int {
    return IndexOf(digitChars, c)
}

func ParseI64(s string) I64ParseResult {
    if len(s) == 0 {
        return I64ParseResult.Invalid
    }
    i := 0
    negative := false
    if s[0:1] == "-" {
        negative = true
        i = 1
        if i >= len(s) {
            return I64ParseResult.Invalid
        }
    } else if s[0:1] == "+" {
        i = 1
        if i >= len(s) {
            return I64ParseResult.Invalid
        }
    }
    var n i64 = 0
    saw := false
    for i < len(s) {
        d := digitValue(s[i:i+1])
        if d < 0 {
            return I64ParseResult.Invalid
        }
        saw = true
        if negative {
            // n is <= 0; check overflow before n = n*10 - d
            if n < (-9223372036854775807 - 1) / 10 {
                return I64ParseResult.Overflow
            }
            next := n * 10 - i64(d)
            if next > n {
                return I64ParseResult.Overflow
            }
            n = next
        } else {
            if n > 9223372036854775807 / 10 {
                return I64ParseResult.Overflow
            }
            next := n * 10 + i64(d)
            if next < n {
                return I64ParseResult.Overflow
            }
            n = next
        }
        i = i + 1
    }
    if !saw {
        return I64ParseResult.Invalid
    }
    return I64ParseResult.Ok(n)
}

func ParseInt(s string) IntParseResult {
    match ParseI64(s) {
        I64ParseResult.Ok(n) => {
            if n > 2147483647 {
                return IntParseResult.Overflow
            }
            if n < -2147483647 - 1 {
                return IntParseResult.Overflow
            }
            return IntParseResult.Ok(int(n))
        }
        I64ParseResult.Invalid => {
            return IntParseResult.Invalid
        }
        I64ParseResult.Overflow => {
            return IntParseResult.Overflow
        }
    }
}

func ParseU64(s string) U64ParseResult {
    if len(s) == 0 {
        return U64ParseResult.Invalid
    }
    i := 0
    if s[0:1] == "+" {
        i = 1
        if i >= len(s) {
            return U64ParseResult.Invalid
        }
    }
    if s[0:1] == "-" {
        return U64ParseResult.Invalid
    }
    var n u64 = 0
    saw := false
    for i < len(s) {
        d := digitValue(s[i:i+1])
        if d < 0 {
            return U64ParseResult.Invalid
        }
        saw = true
        if n > 18446744073709551615 / 10 {
            return U64ParseResult.Overflow
        }
        next := n * 10 + u64(d)
        if next < n {
            return U64ParseResult.Overflow
        }
        n = next
        i = i + 1
    }
    if !saw {
        return U64ParseResult.Invalid
    }
    return U64ParseResult.Ok(n)
}

func ParseF64(s string) F64ParseResult {
    if len(s) == 0 {
        return F64ParseResult.Invalid
    }
    i := 0
    negative := false
    if s[0:1] == "-" {
        negative = true
        i = 1
    } else if s[0:1] == "+" {
        i = 1
    }
    if i >= len(s) {
        return F64ParseResult.Invalid
    }
    var intPart f64 = 0.0
    sawDigit := false
    for i < len(s) {
        c := s[i:i+1]
        if c == "." {
            break
        }
        d := digitValue(c)
        if d < 0 {
            return F64ParseResult.Invalid
        }
        sawDigit = true
        intPart = intPart * 10.0 + f64(d)
        i = i + 1
    }
    var frac f64 = 0.0
    var scale f64 = 1.0
    if i < len(s) && s[i:i+1] == "." {
        i = i + 1
        for i < len(s) {
            d := digitValue(s[i:i+1])
            if d < 0 {
                return F64ParseResult.Invalid
            }
            sawDigit = true
            scale = scale * 10.0
            frac = frac * 10.0 + f64(d)
            i = i + 1
        }
    }
    if i != len(s) || !sawDigit {
        return F64ParseResult.Invalid
    }
    v := intPart
    if scale > 1.0 {
        v = v + frac / scale
    }
    if negative {
        v = -v
    }
    return F64ParseResult.Ok(v)
}

tests {
    import "std:test"

    func TestF64ToStringUnchanged(t *test.Runner) {
        t.AssertEqual(F64ToString(3.14159), "3.1416", "still 4 decimals")
        t.AssertEqual(F64ToString(-1.5), "-1.5000", "negative still 4 decimals")
        t.AssertEqual(F64ToString(0.0), "0.0000", "zero still 4 decimals")
    }

    func TestF64ToStringPrecisionRounds(t *test.Runner) {
        t.AssertEqual(F64ToStringPrecision(3.14159, 2), "3.14", "truncates extra digits")
        t.AssertEqual(F64ToStringPrecision(1.5, 2), "1.50", "keeps a trailing zero")
        t.AssertEqual(F64ToStringPrecision(-1.5, 2), "-1.50", "negative")
        t.AssertEqual(F64ToStringPrecision(0.999996, 4), "1.0000", "rounds up into the integer part")
    }

    func TestIntToStringUnchanged(t *test.Runner) {
        t.AssertEqual(IntToString(0), "0", "zero")
        t.AssertEqual(IntToString(42), "42", "positive")
        t.AssertEqual(IntToString(-42), "-42", "negative")
        t.AssertEqual(IntToString(-2147483647 - 1), "-2147483648", "i32's own minimum")
    }

    // i64's own minimum has no representable positive i64 magnitude to
    // negate - the exact reason Int64ToString's own digit-extraction loop
    // never negates at all (see its doc comment).
    func TestInt64ToStringHandlesI64Minimum(t *test.Runner) {
        t.AssertEqual(Int64ToString(-9223372036854775807 - 1), "-9223372036854775808", "i64's own minimum")
    }

    func TestUInt64ToString(t *test.Runner) {
        t.AssertEqual(UInt64ToString(0), "0", "zero")
        t.AssertEqual(UInt64ToString(42), "42", "ordinary value")
        t.AssertEqual(UInt64ToString(18446744073709551615), "18446744073709551615", "u64's own maximum")
    }
    func TestParseInt(t *test.Runner) {
        match ParseInt("42") {
            IntParseResult.Ok(n) => {
                t.AssertEqual(n, 42, "42")
            }
            _ => {
                t.Assert(false, "expected Ok")
            }
        }
        match ParseInt("-7") {
            IntParseResult.Ok(n) => {
                t.AssertEqual(n, -7, "-7")
            }
            _ => {
                t.Assert(false, "expected Ok neg")
            }
        }
        match ParseInt("abc") {
            IntParseResult.Invalid => {
                t.Assert(true, "invalid")
            }
            _ => {
                t.Assert(false, "expected Invalid")
            }
        }
        match ParseInt("999999999999") {
            IntParseResult.Overflow => {
                t.Assert(true, "overflow")
            }
            _ => {
                t.Assert(false, "expected Overflow")
            }
        }
    }

    func TestParseF64(t *test.Runner) {
        match ParseF64("3.25") {
            F64ParseResult.Ok(v) => {
                t.AssertApprox(v, 3.25, 0.0001, "3.25")
            }
            _ => {
                t.Assert(false, "expected Ok")
            }
        }
        match ParseF64("x") {
            F64ParseResult.Invalid => {
                t.Assert(true, "invalid")
            }
            _ => {
                t.Assert(false, "expected Invalid")
            }
        }
    }

}
