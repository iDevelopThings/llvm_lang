// time.llx - std/time: monotonic QPC stopwatch (same externs as
// examples/scope_timer), Duration in nanoseconds, and Sleep via nanosleep.

import "std:strings"
import "std:os"

extern func QueryPerformanceCounter(counter *i64) bool
extern func QueryPerformanceFrequency(freq *i64) bool

struct timespec {
    tv_sec i64
    tv_nsec i32
}

extern func nanosleep(req *timespec, rem *timespec) i32

func queryFrequency() i64 {
    f := i64(0)
    QueryPerformanceFrequency(&f)
    return f
}

var frequency i64 = queryFrequency()

func Now() i64 {
    t := i64(0)
    QueryPerformanceCounter(&t)
    return t
}

func ElapsedSeconds(startTicks i64) f64 {
    elapsedTicks := Now() - startTicks
    return f64(elapsedTicks) / f64(frequency)
}

func FormattedDuration(seconds f64) string {
    negative := seconds < 0.0
    v := seconds
    if negative {
        v = -v
    }

    unit := "s"
    scaled := v
    if v < 0.000001 {
        unit = "ns"
        scaled = v * 1000000000.0
    } else if v < 0.001 {
        unit = "us"
        scaled = v * 1000000.0
    } else if v < 1.0 {
        unit = "ms"
        scaled = v * 1000.0
    }

    result := strings.F64ToStringPrecision(scaled, 2) + unit
    if negative {
        result = "-" + result
    }
    return result
}

// Duration is a nanosecond count. Zero heap; construct via Nanoseconds/etc.
struct Duration {
    ns i64

    operator +(other Duration) Duration {
        return Duration{this.ns + other.ns}
    }
    operator -(other Duration) Duration {
        return Duration{this.ns - other.ns}
    }
    operator -() Duration {
        return Duration{-this.ns}
    }
}

func Nanoseconds(n i64) Duration {
    return Duration{n}
}

func Microseconds(n i64) Duration {
    return Duration{n * 1000}
}

func Milliseconds(n i64) Duration {
    return Duration{n * 1000000}
}

func Seconds(n i64) Duration {
    return Duration{n * 1000000000}
}

func (Duration) Nanoseconds() i64 {
    return this.ns
}

func (Duration) SecondsF64() f64 {
    return f64(this.ns) / 1000000000.0
}

// Sleep blocks for d via nanosleep. Negative/zero returns Ok immediately.
func Sleep(d Duration) os.Error {
    if d.ns <= 0 {
        return os.Ok()
    }
    sec := d.ns / 1000000000
    nsec := i32(d.ns % 1000000000)
    req := timespec{tv_sec: sec, tv_nsec: nsec}
    rc := nanosleep(&req, nil)
    if rc == 0 {
        return os.Ok()
    }
    return os.LastErrno()
}

tests {
    import "std:test"

    func TestFormattedDurationPicksUnit(t *test.Runner) {
        t.AssertEqual(FormattedDuration(0.0000000005), "0.50ns", "sub-microsecond -> ns")
        t.AssertEqual(FormattedDuration(0.00000123), "1.23us", "microsecond range")
        t.AssertEqual(FormattedDuration(0.0015), "1.50ms", "millisecond range")
        t.AssertEqual(FormattedDuration(1.5), "1.50s", "second range")
        t.AssertEqual(FormattedDuration(0.0), "0.00ns", "zero")
    }

    func TestFormattedDurationBoundaries(t *test.Runner) {
        t.AssertEqual(FormattedDuration(0.000001), "1.00us", "exactly 1us, not 1000.00ns")
        t.AssertEqual(FormattedDuration(0.001), "1.00ms", "exactly 1ms, not 1000.00us")
        t.AssertEqual(FormattedDuration(1.0), "1.00s", "exactly 1s, not 1000.00ms")
    }

    func TestFormattedDurationNegative(t *test.Runner) {
        t.AssertEqual(FormattedDuration(-1.5), "-1.50s", "negative duration keeps its sign")
    }

    func TestDurationArithmetic(t *test.Runner) {
        a := Milliseconds(1500)
        b := Microseconds(500)
        sum := a + b
        t.AssertEqual(sum.Nanoseconds(), i64(1500500000), "ms+us")
        t.AssertEqual(Seconds(2).Nanoseconds(), i64(2000000000), "Seconds")
        diff := a - Milliseconds(500)
        t.AssertEqual(diff.Nanoseconds(), i64(1000000000), "subtract")
        neg := -Milliseconds(1)
        t.AssertEqual(neg.Nanoseconds(), i64(-1000000), "unary minus")
    }

    func TestSleepSmoke(t *test.Runner) {
        start := Now()
        err := Sleep(Milliseconds(1))
        t.Assert(err.IsOk(), "Sleep Ok")
        elapsed := ElapsedSeconds(start)
        t.Assert(elapsed >= 0.0005, "slept at least ~0.5ms")
        t.Assert(elapsed < 1.0, "slept under 1s")
    }
}