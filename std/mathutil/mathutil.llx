// mathutil.llx - std/mathutil: a small math standard-library package, built
// entirely as ordinary .llx code (see LANGUAGE.md's "Standard library"
// section) - no compiler changes, just this project's own existing
// `extern func` FFI (LANGUAGE.md's "External functions (FFI)" section) for
// the handful of operations libc's <math.h> already provides, plus a few
// pure-.llx helpers that don't need libc at all.
//
// Named "mathutil" (not "mathutils") deliberately, distinct from
// examples/imports/mathutils's own unrelated demo package of the same
// near-name - imports in this language are resolved by relative path, not a
// global package registry (see LANGUAGE.md's "Imports" section), so the two
// could never actually collide either way; the naming is just to avoid any
// human confusion between "the real std package" and "an example fixture"
// when skimming directory listings side by side.
//
// Every extern binds the exact real libc symbol name (lowercase, matching
// <math.h> itself - "the declared name is the linked symbol name, verbatim",
// per LANGUAGE.md), which also means the raw binding is unexported (a
// lowercase top-level name is never visible through a package qualifier -
// see LANGUAGE.md's "Imports" section) and so can't be dialed cross-package
// on its own. Each one gets an ordinary, capitalized wrapper function right
// underneath it - a one-line pass-through - purely to give it an exported,
// callable-as-mathutil.Sqrt(...) name; this isn't renaming the extern itself
// (still not supported, see LANGUAGE.md), just an exported facade in front
// of an unexported binding, same pattern any Go package uses to expose a
// lowercase-named C import under a nicer public name.
//
// All five all taking/returning f64, all part of mingw64's default C
// runtime - already always linked into this project's own JIT-hosting
// process (see CODEGEN.md), so no special linking/loading step is needed
// here, same as examples/scope_timer's own kernel32 extern calls.

extern func sqrt(x f64) f64
extern func pow(base f64, exp f64) f64
extern func floor(x f64) f64
extern func ceil(x f64) f64
extern func fabs(x f64) f64
extern func sin(x f64) f64
extern func cos(x f64) f64
extern func tan(x f64) f64
extern func atan2(y f64, x f64) f64

func Sqrt(x f64) f64 {
	return sqrt(x)
}

func Pow(base f64, exp f64) f64 {
	return pow(base, exp)
}

func Floor(x f64) f64 {
	return floor(x)
}

func Ceil(x f64) f64 {
	return ceil(x)
}

func Fabs(x f64) f64 {
	return fabs(x)
}

// Abs/Min/Max below need no libc call at all - plain comparison-based
// arithmetic, generic over T (LANGUAGE.md's "Generics" section) instead of
// this file's former hand-duplicated AbsInt/MinInt/MaxInt/MinF64/MaxF64. No
// constraint is declared or needed: each is only checked against whatever T
// an actual call site instantiates it with, so e.g. Abs[T] simply fails to
// compile with an ordinary diagnostic if ever instantiated with a T that has
// no unary `-`/`<` (a struct, say) - that's expected per-instantiation
// behavior, not a gap to guard against here.

// Abs returns x's absolute value.
func Abs[T](x T) T {
	if x < 0 {
		return -x
	}
	return x
}

// Min returns whichever of a/b is smaller.
func Min[T](a T, b T) T {
	if a < b {
		return a
	}
	return b
}

// Max returns whichever of a/b is larger.
func Max[T](a T, b T) T {
	if a > b {
		return a
	}
	return b
}

func Clamp[T](x T, min T, max T) T {
	if x < min {
		return min
	}
	if x > max {
		return max
	}
	return x
}

func Normalize2D[T](x T, y T) (T, T) {
	xf := f64(x)
	yf := f64(y)
	mag := sqrt(xf*xf + yf*yf)
	return T(xf / mag), T(yf / mag)
}

func Sin(x f64) f64 {
	return sin(x)
}

func Cos(x f64) f64 {
	return cos(x)
}

func Tan(x f64) f64 {
	return tan(x)
}

func Atan2(y f64, x f64) f64 {
	return atan2(y, x)
}

var Pi f64 = 3.141592653589793

tests {
	import "std:test"

	func TestTrig(t *test.Runner) {
		t.AssertApprox(Sin(0.0), 0.0, 0.0000001, "sin0")
		t.AssertApprox(Cos(0.0), 1.0, 0.0000001, "cos0")
		t.AssertApprox(Sin(Pi / 2.0), 1.0, 0.0000001, "sin pi/2")
		t.AssertApprox(Cos(Pi), -1.0, 0.0000001, "cos pi")
		t.AssertApprox(Atan2(0.0, 1.0), 0.0, 0.0000001, "atan2")
		t.AssertApprox(Tan(0.0), 0.0, 0.0000001, "tan0")
	}
}