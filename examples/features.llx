// features.llx - a slightly bigger program exercising a struct with a
// mutating method, a for loop, a fixed-size array, and arithmetic, then
// returns an int - which becomes this process's own exit code (see
// cmd/llvmc's package doc comment).
//
// Run with:
//   .\llvmc.exe examples\features.llx
//   echo $LASTEXITCODE   # (PowerShell) -> 30

struct Point {
    x int
    y int
}

func (Point) sum() int {
    return this.x + this.y
}

func (Point) move(dx int, dy int) {
    this.x = this.x + dx
    this.y = this.y + dy
}

func main() int {
    p := Point{1, 2}
    p.move(3, 4)
    print(p.sum())          // (1+3) + (2+4) = 10

    total := 0
    for i := 0; i < 5; i++ {
        total += i * i
    }
    print(total)             // 0+1+4+9+16 = 30

    a := [4]int{10, 20, 30, 40}
    arrSum := 0
    for i := 0; i < 4; i++ {
        arrSum += a[i]
    }
    print(arrSum)            // 10+20+30+40 = 100

    return total
}
