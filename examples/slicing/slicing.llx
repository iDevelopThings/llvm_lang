// slicing.llx - demonstrates Go-style slice expressions (`s[a:b]`, `s[:b]`,
// `s[a:]`, `s[:]`) over all three operand types they work on - a dynamic
// array, a string, and a fixed-size array - and the real, no-copy aliasing
// that makes slicing worth having at all (see LANGUAGE.md's "Slicing"
// section).
//
// Run with:
//   .\llvmc.exe examples\slicing\slicing.llx
//   echo $LASTEXITCODE   # (PowerShell) -> 5

func main() int {
    // A dynamic array (`[]T`) slices to another `[]T` - a fresh header
    // sharing the exact same backing memory, no copy: writing through mid
    // is visible through s too.
    s := []int{10, 20, 30, 40, 50}
    mid := s[1:4]
    print(mid)          // [20 30 40]
    print(len(mid))     // 3
    mid[0] = 99
    print(s[1])         // 99 - the write is visible through the original too

    // A slice past the current length but still within capacity is legal -
    // the high bound is checked against cap(s), not len(s).
    grown := make([]int, 2, 4)
    grown[0] = 1
    grown[1] = 2
    wider := grown[0:4]
    print(len(wider))   // 4

    // A string slices to another `string`, sharing the same backing bytes
    // (strings are immutable, so this sharing is read-only) - `str[a:]`
    // omits the high bound (defaults to len), `str[:b]` omits the low bound
    // (defaults to 0).
    str := "hello world"
    print(str[6:])      // "world"
    print(str[:5])      // "hello"
    print(str[6:11])    // "world"

    // Slicing a fixed-size array (`[N]T`) produces a genuine `[]T`, not
    // another `[N]T` - matching Go's own real behavior - and shares the
    // fixed array's own storage, exactly like the dynamic-array case above.
    arr := [5]int{1, 2, 3, 4, 5}
    view := arr[1:3]
    print(view)         // [2 3]
    view[0] = 100
    print(arr[1])       // 100 - shares the fixed array's own storage

    return len(mid) + len(view)   // 3 + 2 = 5
}
