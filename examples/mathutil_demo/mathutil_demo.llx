// mathutil_demo.llx - std/mathutil wrappers including trig.
//
// Run with:
//   .\llvmc.exe examples\mathutil_demo\mathutil_demo.llx
//   echo $LASTEXITCODE   # -> 19

import "std:mathutil"

func main() int {
    print(mathutil.Sqrt(16.0))
    print(mathutil.Pow(2.0, 10.0))
    print(mathutil.Floor(3.7))
    print(mathutil.Ceil(3.2))
    print(mathutil.Fabs(-5.5))

    absResult := mathutil.Abs(-7)
    print(absResult)

    minResult := mathutil.Min(3, 9)
    maxResult := mathutil.Max(3, 9)
    print(minResult)
    print(maxResult)

    print(mathutil.Min(2.5, 1.5))
    print(mathutil.Max(2.5, 1.5))

    print(mathutil.Sin(0.0))
    print(mathutil.Cos(0.0))
    print(mathutil.Pi)

    return absResult + minResult + maxResult
}