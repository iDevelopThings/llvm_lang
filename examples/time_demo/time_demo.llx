// time_demo.llx - std/time Now/ElapsedSeconds plus Duration/Sleep.
//
// Run with:
//   .\llvmc.exe examples\time_demo\time_demo.llx
//   echo $LASTEXITCODE   # -> 4

import "std:time"

func busyWork() i64 {
    var sum i64 = 0
    i := 0
    for i < 2000000 {
        sum = sum + i64(i)
        i++
    }
    return sum
}

func main() int {
    start := time.Now()
    result := busyWork()
    elapsed := time.ElapsedSeconds(start)

    print(result)
    print(elapsed)

    ok := 0
    if elapsed >= 0.0 {
        ok = ok + 1
    }
    if elapsed < 5.0 {
        ok = ok + 1
    }
    end := time.Now()
    if end >= start {
        ok = ok + 1
    }

    d := time.Milliseconds(1) + time.Microseconds(500)
    print(d.Nanoseconds())
    err := time.Sleep(time.Milliseconds(1))
    if err.IsOk() {
        ok = ok + 1
    }

    print(ok)
    return ok
}