// test_demo.llx - exercises llvmc -test and std/test helpers.
// Run with: llvmc -test examples/test_demo
// Deliberately includes one failing test so the suite exits 1.

import "../../std/test"

func add(a int, b int) int {
    return a + b
}

func TestAdd(t *test.Runner) {
    t.AssertEqual(add(2, 3), 5, "2+3")
    t.AssertFalse(add(1, 1) == 3, "1+1 is not 3")
}

func TestNilPointer(t *test.Runner) {
    var p *int = nil
    t.AssertNil(p, "nil pointer")
    x := 7
    p = &x
    t.AssertNotNil(p, "address of local")
    t.AssertEqual(*p, 7, "pointee")
}

func TestSliceEqual(t *test.Runner) {
    got := []int{1, 2, 3}
    want := []int{1, 2, 3}
    t.AssertSliceEqual(got, want, "same elems")
}

func TestApprox(t *test.Runner) {
    t.AssertApprox(1.0, 1.0000001, 0.001, "close floats")
}

// Intentionally fails - proves -test exit code 1 and FAIL reporting.
func TestDeliberateFailure(t *test.Runner) {
    t.AssertEqual(1, 2, "want unequal ints to fail")
}
