// GAP: reading an exported var through a package qualifier.
// Actual:  codegen panic "identifier lib has no storage"
// Expected: print(lib.X) loads the imported package's global.
//
// Run: .\llvmc.exe examples\compiler_gaps\package_qualified_var\app

import "../lib"

func main() int {
    print(lib.X)
    return lib.X
}