// GAP: explicit conversion from *u8/*i8 to cstring (same ABI).
// Actual:  "cannot convert *u8 to cstring"
// Expected: cstring(p) allowed for p *u8 or *i8 (and ideally the reverse).
// Needed to turn a fread/memcpy buffer into string(cstring(...)).
//
// Run: .\llvmc.exe examples\compiler_gaps\cstring_from_ptr

func main() int {
    buf := make([]u8, 4)
    buf[0] = 65
    buf[1] = 66
    buf[2] = 67
    buf[3] = 0
    cs := cstring(&buf[0])
    print(string(cs))
    return 0
}