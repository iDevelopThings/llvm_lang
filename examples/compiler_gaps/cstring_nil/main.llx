// GAP: cstring null check (needed for getenv and similar).
// Actual:  "cannot compare nil with cstring"
// Expected: cs == nil / cs != nil, same as *T (cstring is a raw char*).
//
// Run: .\llvmc.exe examples\compiler_gaps\cstring_nil

extern func getenv(name cstring) cstring

func main() int {
    cs := getenv(cstring("LLX_COMPILER_GAP_MISSING_ENV"))
    if cs == nil {
        print("missing")
        return 0
    }
    print(string(cs))
    return 1
}