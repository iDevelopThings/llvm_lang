// coroutines.llx - demonstrates true suspend/resume coroutines (see
// LANGUAGE.md's "Coroutines" section): an `async func` with two `await`
// points, driven by hand-written code calling resume(h)/done(h) in a loop
// until finished (proving normal completion runs every segment and every
// destructor at exactly the right point), and a second scenario proving an
// early `delete` on a still-suspended handle destructs exactly what's live
// at that exact suspend point - no more, no less.
//
// Run with:
//   .\llvmc.exe examples\coroutines\coroutines.llx
//   echo $LASTEXITCODE   # (PowerShell) -> 0
//
// IMPORTANT: this example must NOT be compiled with -no-opt - see
// CODEGEN.md's "Coroutines" section: llvm.coro.* intrinsics are only ever
// lowered into real code by the optimization pipeline's own coroutine
// passes, and llvmc refuses to compile any program declaring an async
// function under -no-opt for exactly this reason (a clean compile-time
// error, not silently wrong output - see that section).

struct Resource {
    id int

    constructor(v int) {
        this.id = v
    }
    destructor() {
        print(this.id)
    }
}

// Sequence constructs one Resource per segment, printing a marker right
// after each - three segments (before the first await, between the two
// awaits, after the second await) separated by two await points.
async func Sequence() {
    a := Resource(1)
    print(100)
    await
    b := Resource(2)
    print(200)
    await
    c := Resource(3)
    print(300)
}

// driveToCompletion calls Sequence(), then resumes it in a loop until
// done(h) - proving normal completion runs every segment (100, 200, 300)
// and then destructs every still-live local in reverse declaration order
// (c, b, a -> prints 3, 2, 1) via the coroutine's own final suspend, before
// resume(h) ever reports "finished". The trailing `delete h` (on an
// already-done handle) is then a safe, defined no-op against the frame only -
// nothing prints again.
func driveToCompletion() {
    h := Sequence()
    for !done(h) {
        resume(h)
    }
    delete h
}

// destroyEarly calls Sequence(), resumes it exactly once (reaching the
// second await, having constructed a and b but never c), then explicitly
// `delete`s it while still suspended there - proving early destruction
// destructs exactly what's live at that exact point (b then a, reverse
// declaration order: prints 2, 1) and nothing belonging to the segment
// that never ran (c's own constructor/destructor never fire at all).
func destroyEarly() {
    h := Sequence()
    resume(h)
    delete h
}

func main() int {
    driveToCompletion()
    // prints so far: 100, 200, 300, 3, 2, 1

    destroyEarly()
    // prints: 100, 200, 2, 1

    return 0
}
