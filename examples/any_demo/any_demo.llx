// any_demo.llx - exercises the type-erased Any type and its reflection
// builtins: AnyKind, AnyName, AnyAs, AnyFields, AnyLen, AnyIndex.
//
// Run with:
//   .\llvmc.exe examples\any_demo\any_demo.llx
//   echo $LASTEXITCODE   # (PowerShell) -> 6  (all six sanity checks passed)

struct Point {
    X int
    Y int
}

func main() int {
    ok := 0

    // Box a primitive, read it back with AnyName/AnyAs.
    boxedInt := Any(42)
    print(AnyName(boxedInt))   // "int"
    v, matched := AnyAs[int](boxedInt)
    if matched && v == 42 {
        ok = ok + 1
    }

    // A mismatched AnyAs[T] returns false, not a crash or a garbage value.
    _, wrongKind := AnyAs[f64](boxedInt)
    if !wrongKind {
        ok = ok + 1
    }

    // Box a struct; AnyKind is stable across two values of the same kind.
    p := Point{X: 3, Y: 4}
    boxedPoint := Any(p)
    print(AnyName(boxedPoint))   // "Point"
    if AnyKind(boxedInt) == AnyKind(Any(7)) {
        ok = ok + 1
    }

    // Walk a boxed struct's own fields - each itself boxed as an Any.
    sum := 0
    for name, field := range AnyFields(boxedPoint) {
        print(name)   // "X" then "Y"
        fv, fok := AnyAs[int](field)
        if fok {
            sum = sum + fv
        }
    }
    if sum == 7 {
        ok = ok + 1
    }

    // Any(x) where x is already Any is a legal no-op copy.
    reboxed := Any(boxedInt)
    rv, rok := AnyAs[int](reboxed)
    if rok && rv == 42 {
        ok = ok + 1
    }

    // Boxed arrays: AnyLen/AnyIndex, in bounds and out of bounds.
    boxedArr := Any([]int{10, 20, 30})
    elem, elemOk := AnyIndex(boxedArr, 1)
    ev, evOk := AnyAs[int](elem)
    oobElem, oobOk := AnyIndex(boxedArr, 99)
    if AnyLen(boxedArr) == 3 && elemOk && evOk && ev == 20 && !oobOk {
        ok = ok + 1
    }

    print(ok)   // 6
    return ok
}
